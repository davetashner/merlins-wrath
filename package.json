{
  "name": "the-vesper-bell",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench --run",
    "e2e": "playwright test",
    "e2e:shards": "node scripts/e2e-shards-cli.ts files",
    "e2e:shards:regenerate": "node scripts/e2e-shards-cli.ts regenerate",
    "slice:record": "SLICE_RECORD=1 playwright test e2e/slice-record.spec.ts --project=chromium --retries=0",
    "perf": "playwright test -c playwright.perf.config.ts --project=ci",
    "perf:ref": "playwright test -c playwright.perf.config.ts --project=reference",
    "perf:budgets": "node scripts/perf/budgets-cli.ts",
    "perf:compare": "node scripts/perf/compare-cli.ts",
    "coverage:ratchet": "node scripts/coverage-ratchet-cli.ts",
    "coverage:baseline": "node scripts/coverage-ratchet-cli.ts --write-baseline",
    "coverage:exclusions": "node scripts/check-coverage-exclusions-cli.ts",
    "content:coverage": "node scripts/content-coverage-cli.ts",
    "content:loot": "node scripts/loot-check-cli.ts",
    "content:schemas": "node scripts/content-schemas-cli.ts",
    "content:docs": "node scripts/content-docs-cli.ts",
    "nav:bake": "node scripts/nav-bake-cli.ts bake",
    "nav:check": "node scripts/nav-bake-cli.ts check",
    "audio:placeholders": "node scripts/audio/gen-placeholders-cli.ts",
    "audio:placeholder-report": "node scripts/audio/placeholder-report-cli.ts",
    "vfx:placeholders": "node scripts/vfx/gen-placeholders-cli.ts",
    "vfx:placeholder-report": "node scripts/vfx/placeholder-report-cli.ts",
    "secrets:lint": "node scripts/check-gitleaks-config-cli.ts",
    "hooks:install": "git config core.hooksPath .beads/hooks",
    "deps:audit": "pnpm audit --json > audit.json; node scripts/dependency-audit-cli.ts --audit audit.json",
    "beads:validate": "node scripts/validate-beads-cli.ts",
    "replay:record": "node scripts/replay-cli.ts record",
    "replay:rebless": "node scripts/replay-cli.ts rebless",
    "save:fixture": "node scripts/save-fixture-cli.ts generate",
    "save:check": "node scripts/save-fixture-cli.ts check"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.1",
    "@types/three": "0.186.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-wasm": "3.6.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@dimforge/rapier3d-deterministic": "0.21.0",
    "three": "0.186.1",
    "zod": "^4.6.5"
  }
}

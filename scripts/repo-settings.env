# Expected GitHub settings for davetashner/thevesperbell (mw-e00.10). Sourced by
# scripts/configure-repo.sh and scripts/verify-repo-settings.sh; docs/repo-settings.md explains each.
# When a check bead adds a CI job that runs on every PR, add its job name here and re-run configure.
REPO="${REPO:-davetashner/thevesperbell}"
BRANCH="main"
# Jobs that run on every pull request. Path-filtered jobs (plan-check's `validate`) must NOT be listed:
# a required check that never runs blocks merging.
REQUIRED_CHECKS="lint typecheck unit coverage-gate coverage-ratchet e2e-smoke build beads-validate secrets audit dependency-review pr-lint changelog"

{
  "$schema": "../behaviour.schema.json",
  "id": "forgotten-archer",
  "notes": "The Forgotten archer's fight (mw-ju8.19, ADR-0005): the Forgotten's habit-driven alert states (see behaviour forgotten) with its own Combat. It keeps its distance: at 4.5 m or more with the shot ready it draws and looses (the attack's own range and cooldown gate it), inside 6.5 m it backs away at a run (a circle to a 9 m ring, so it also sidesteps), and closed on within 1.8 m it shoves with the bow stave (melee fallback) before backing off again. Out of reach it rattles. The shot and the shove are not interruptible, so the draw is never walked out of.",
  "tuning": {
    "suspiciousTimeoutS": 12,
    "searchingTimeoutS": 20,
    "alertedTimeoutS": 15,
    "combatLostS": 6,
    "preferredRange": 9,
    "leashSearchS": 2
  },
  "thinkHz": 10,
  "inertia": 0.1,
  "initial": "unaware",
  "states": {
    "unaware": {
      "transitions": [
        {
          "to": "suspicious",
          "when": {
            "input": "awareness",
            "gte": {
              "tuning": "suspiciousAt"
            }
          }
        },
        {
          "to": "alerted",
          "when": {
            "event": "damaged-by-unseen"
          }
        }
      ],
      "activities": ["home", "stand"]
    },
    "suspicious": {
      "timeoutS": {
        "tuning": "suspiciousTimeoutS"
      },
      "onTimeout": "unaware",
      "transitions": [
        {
          "to": "combat",
          "when": {
            "input": "targetVisible",
            "gte": 1
          }
        },
        {
          "to": "alerted",
          "when": {
            "event": "damaged-by-unseen"
          }
        },
        {
          "to": "unaware",
          "when": {
            "done": "seek"
          }
        },
        {
          "to": "unaware",
          "when": {
            "failed": "seek"
          }
        }
      ],
      "activities": ["seek"]
    },
    "searching": {
      "timeoutS": {
        "tuning": "searchingTimeoutS"
      },
      "onTimeout": "unaware",
      "postAlert": true,
      "transitions": [
        {
          "to": "combat",
          "when": {
            "input": "targetVisible",
            "gte": 1
          }
        }
      ],
      "activities": ["search", "scan"]
    },
    "alerted": {
      "timeoutS": {
        "tuning": "alertedTimeoutS"
      },
      "onTimeout": "searching",
      "transitions": [
        {
          "to": "combat",
          "when": {
            "input": "targetVisible",
            "gte": 1
          }
        },
        {
          "to": "searching",
          "when": {
            "done": "hunt"
          }
        },
        {
          "to": "searching",
          "when": {
            "failed": "hunt"
          }
        }
      ],
      "activities": ["hunt"]
    },
    "combat": {
      "transitions": [
        {
          "to": "searching",
          "when": {
            "input": "targetLostS",
            "gte": {
              "tuning": "combatLostS"
            }
          }
        }
      ],
      "activities": ["shoot", "stab", "kite", "strafe", "rattle"]
    }
  },
  "activities": {
    "home": {
      "weight": 2,
      "considerations": [
        {
          "input": "fromPost",
          "curve": {
            "kind": "step",
            "at": 0.5,
            "below": 0,
            "above": 1
          }
        }
      ],
      "steps": [
        {
          "do": "move-to",
          "target": "post",
          "within": 0.5,
          "gait": "run"
        }
      ]
    },
    "stand": {
      "steps": [
        {
          "do": "wait",
          "seconds": 1
        }
      ]
    },
    "seek": {
      "steps": [
        {
          "do": "look-at",
          "target": "stimulus",
          "seconds": 1
        },
        {
          "do": "move-to",
          "target": "stimulus",
          "within": 1
        },
        {
          "do": "look-around",
          "seconds": 3
        },
        {
          "do": "forget-stimulus"
        }
      ]
    },
    "search": {
      "steps": [
        {
          "do": "move-to",
          "target": "lkp",
          "within": 1
        },
        {
          "do": "look-around",
          "seconds": 4
        }
      ]
    },
    "scan": {
      "weight": 0.5,
      "steps": [
        {
          "do": "look-around",
          "seconds": 4
        }
      ]
    },
    "hunt": {
      "steps": [
        {
          "do": "look-at",
          "target": "lkp",
          "seconds": 1
        },
        {
          "do": "move-to",
          "target": "lkp",
          "within": 1,
          "gait": "run"
        },
        {
          "do": "look-around",
          "seconds": 3
        }
      ]
    },
    "rattle": {
      "weight": 2,
      "considerations": [
        {
          "input": "targetUnreachableS",
          "curve": {
            "kind": "step",
            "at": 8,
            "below": 0,
            "above": 1
          }
        }
      ],
      "steps": [
        {
          "do": "look-at",
          "target": "target",
          "seconds": 1
        },
        {
          "do": "play-cue",
          "cue": "forgotten-rattle"
        },
        {
          "do": "wait",
          "seconds": 3
        }
      ]
    },
    "shoot": {
      "weight": 3,
      "interruptible": false,
      "retryAfterS": 0.5,
      "considerations": [
        {
          "input": "targetDistance",
          "curve": {
            "kind": "step",
            "at": 4.5,
            "below": 0,
            "above": 1
          }
        },
        {
          "input": "attackToken",
          "curve": {
            "kind": "step",
            "at": 1,
            "below": 0,
            "above": 1
          }
        }
      ],
      "steps": [
        {
          "do": "attack",
          "attack": "forgotten-archer-shot"
        }
      ]
    },
    "stab": {
      "weight": 4,
      "interruptible": false,
      "retryAfterS": 0.5,
      "considerations": [
        {
          "input": "targetDistance",
          "curve": {
            "kind": "step",
            "at": 1.8,
            "below": 1,
            "above": 0
          }
        },
        {
          "input": "attackToken",
          "curve": {
            "kind": "step",
            "at": 1,
            "below": 0,
            "above": 1
          }
        }
      ],
      "steps": [
        {
          "do": "attack",
          "attack": "forgotten-archer-shove"
        }
      ]
    },
    "kite": {
      "weight": 2,
      "considerations": [
        {
          "input": "targetDistance",
          "curve": {
            "kind": "step",
            "at": 6.5,
            "below": 1,
            "above": 0
          }
        }
      ],
      "steps": [
        {
          "do": "circle",
          "range": {
            "tuning": "preferredRange"
          },
          "seconds": 2,
          "gait": "run"
        }
      ]
    },
    "strafe": {
      "weight": 1,
      "considerations": [
        {
          "input": "targetDistance",
          "curve": {
            "kind": "step",
            "at": 6.5,
            "below": 0,
            "above": 1
          }
        }
      ],
      "steps": [
        {
          "do": "circle",
          "range": {
            "tuning": "preferredRange"
          },
          "seconds": 2,
          "gait": "walk"
        }
      ]
    }
  }
}

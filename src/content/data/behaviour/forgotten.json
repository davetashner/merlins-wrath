{
  "$schema": "../behaviour.schema.json",
  "id": "forgotten",
  "notes": "The Forgotten skeleton's fight (mw-e13.1, ADR-0005), the vertical slice's arena encounter: it stands where it was left until it notices someone, turns to a noise and shambles over to look, and fights anyone it sees. Leashed to its post (mw-e01.17), it chases only so far: past the leash it drops its target, searches the leash edge for a moment and lurches home, wounds and all, to stand at its post again. Struck by something it did not see, it is Alerted: it turns toward where the blow came from and hurries over to look. When its target slips out of sight it searches the last place it saw them, then stands down still on edge (mw-e11.7). In Combat (mw-e11.13) it presses in and strikes with one of its e04 grey-box attacks, chosen by the attacks' own ranges, cooldowns and weights: the overhead chop (the parry-practice swing) and the two-hit slash up close, the lunging thrust when the target hangs back at 1.6-2.8 m. While its swings cool down it circles at its preferred range, and below a target it cannot reach it waits, then rattles at them. Its habits (sweeping, hauling, ignoring quiet players) are mw-e13.4; in the slice it rests at its post by pillar B and wakes on sight or a clatter in the arena (mw-e01.5); crumbling and reassembling is mw-e13.3.",
  "tuning": {
    "suspiciousTimeoutS": 12,
    "searchingTimeoutS": 20,
    "alertedTimeoutS": 15,
    "combatLostS": 6,
    "preferredRange": 2.2,
    "leashSearchS": 2
  },
  "thinkHz": 10,
  "inertia": 0.1,
  "initial": "unaware",
  "states": {
    "unaware": {
      "transitions": [
        {
          "to": "suspicious",
          "when": { "input": "awareness", "gte": { "tuning": "suspiciousAt" } }
        },
        { "to": "alerted", "when": { "event": "damaged-by-unseen" } }
      ],
      "activities": ["home", "stand"]
    },
    "suspicious": {
      "timeoutS": { "tuning": "suspiciousTimeoutS" },
      "onTimeout": "unaware",
      "transitions": [
        { "to": "combat", "when": { "input": "targetVisible", "gte": 1 } },
        { "to": "alerted", "when": { "event": "damaged-by-unseen" } },
        { "to": "unaware", "when": { "done": "seek" } },
        { "to": "unaware", "when": { "failed": "seek" } }
      ],
      "activities": ["seek"]
    },
    "searching": {
      "timeoutS": { "tuning": "searchingTimeoutS" },
      "onTimeout": "unaware",
      "postAlert": true,
      "transitions": [{ "to": "combat", "when": { "input": "targetVisible", "gte": 1 } }],
      "activities": ["search", "scan"]
    },
    "alerted": {
      "timeoutS": { "tuning": "alertedTimeoutS" },
      "onTimeout": "searching",
      "transitions": [
        { "to": "combat", "when": { "input": "targetVisible", "gte": 1 } },
        { "to": "searching", "when": { "done": "hunt" } },
        { "to": "searching", "when": { "failed": "hunt" } }
      ],
      "activities": ["hunt"]
    },
    "combat": {
      "transitions": [
        {
          "to": "searching",
          "when": { "input": "targetLostS", "gte": { "tuning": "combatLostS" } }
        }
      ],
      "activities": ["press", "circle", "rattle"]
    }
  },
  "activities": {
    "home": {
      "weight": 2,
      "considerations": [
        { "input": "fromPost", "curve": { "kind": "step", "at": 0.5, "below": 0, "above": 1 } }
      ],
      "steps": [{ "do": "move-to", "target": "post", "within": 0.5, "gait": "run" }]
    },
    "stand": {
      "steps": [{ "do": "wait", "seconds": 1 }]
    },
    "seek": {
      "steps": [
        { "do": "look-at", "target": "stimulus", "seconds": 1 },
        { "do": "move-to", "target": "stimulus", "within": 1 },
        { "do": "look-around", "seconds": 3 },
        { "do": "forget-stimulus" }
      ]
    },
    "search": {
      "steps": [
        { "do": "move-to", "target": "lkp", "within": 1 },
        { "do": "look-around", "seconds": 4 }
      ]
    },
    "scan": {
      "weight": 0.5,
      "steps": [{ "do": "look-around", "seconds": 4 }]
    },
    "hunt": {
      "steps": [
        { "do": "look-at", "target": "lkp", "seconds": 1 },
        { "do": "move-to", "target": "lkp", "within": 1, "gait": "run" },
        { "do": "look-around", "seconds": 3 }
      ]
    },
    "press": {
      "interruptible": false,
      "considerations": [
        { "input": "attackToken", "curve": { "kind": "step", "at": 1, "below": 0, "above": 1 } },
        {
          "input": "targetUnreachableS",
          "curve": { "kind": "step", "at": 8, "below": 1, "above": 0 }
        }
      ],
      "steps": [{ "do": "strike", "gait": "run", "giveUpS": 8 }]
    },
    "circle": {
      "weight": 0.5,
      "considerations": [
        {
          "input": "targetUnreachableS",
          "curve": { "kind": "step", "at": 8, "below": 1, "above": 0 }
        }
      ],
      "steps": [{ "do": "circle", "range": { "tuning": "preferredRange" }, "seconds": 2 }]
    },
    "rattle": {
      "weight": 2,
      "considerations": [
        {
          "input": "targetUnreachableS",
          "curve": { "kind": "step", "at": 8, "below": 0, "above": 1 }
        }
      ],
      "steps": [
        { "do": "look-at", "target": "target", "seconds": 1 },
        { "do": "play-cue", "cue": "forgotten-rattle" },
        { "do": "wait", "seconds": 3 }
      ]
    }
  }
}

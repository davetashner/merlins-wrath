{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Editor hint only; ignored by the loader."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Unique arrow id, e.g. \"standard\". Stable once shipped (saves)."
    },
    "schemaVersion": {
      "default": 1,
      "description": "ArrowDef schema version, for future migrations.",
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Display name, e.g. \"Standard Arrow\"."
    },
    "notes": {
      "description": "Where the numbers come from (bead, design intent), for owner review.",
      "type": "string",
      "minLength": 1
    },
    "massGrams": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1000,
      "description": "Mass, grams (ballistics: a = F / m)."
    },
    "dragK": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Quadratic drag constant k, kg/m: drag acceleration = −k·v·|v| / m (e05.2)."
    },
    "damage": {
      "type": "object",
      "properties": {
        "amounts": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "slash",
              "pierce",
              "blunt",
              "fire",
              "frost",
              "shock",
              "arcane",
              "poison"
            ]
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          },
          "description": "Damage points per damage type (before resistances); unlisted types deal 0."
        },
        "poiseDamage": {
          "default": 0,
          "description": "Poise damage in points.",
          "type": "number",
          "minimum": 0
        },
        "staminaDamage": {
          "default": 0,
          "description": "Stamina drained from a blocker, in points (before shield stability).",
          "type": "number",
          "minimum": 0
        },
        "impulse": {
          "description": "Knockback impulse, N·s, in the attacker’s frame (+z forward, +y up).",
          "default": {
            "x": 0,
            "y": 0,
            "z": 0
          },
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            }
          },
          "required": [
            "x",
            "y",
            "z"
          ],
          "additionalProperties": false
        },
        "impactForce": {
          "default": 0,
          "description": "Peak impact force, N (breakables, knockdown).",
          "type": "number",
          "minimum": 0
        },
        "tags": {
          "description": "Damage-packet tags every hit carries, e.g. \"critical\" (damage model tags).",
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      },
      "required": [
        "amounts"
      ],
      "additionalProperties": false,
      "description": "Damage packet at launch speed (same template as a move’s); ballistics scales it by speed."
    },
    "penetration": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Penetration rating (0–100) against surface hardness: soft 5, medium 10, hard 40; a sticking arrow embeds when it reaches the surface’s rating."
    },
    "onImpact": {
      "type": "string",
      "enum": [
        "stick",
        "bounce",
        "shatter"
      ],
      "description": "stick (if it penetrates), bounce, or shatter."
    },
    "retrievable": {
      "default": true,
      "description": "Can be picked up again after it lands (intact roll: e05.7); shattering ones cannot.",
      "type": "boolean"
    },
    "properties": {
      "description": "World properties the arrow itself carries in flight, e.g. a fire arrow is burning.",
      "type": "object",
      "properties": {
        "material": {
          "description": "Material preset id (a material content entry).",
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "x-contentRef": "material"
        },
        "temperature": {
          "type": "number",
          "minimum": -273.15,
          "maximum": 10000,
          "description": "Current temperature, °C."
        },
        "flammable": {
          "type": "boolean",
          "description": "Fire can ignite it."
        },
        "ignitionPoint": {
          "type": "number",
          "minimum": -273.15,
          "maximum": 10000,
          "description": "Temperature at which it ignites, °C."
        },
        "fuel": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400,
          "description": "Seconds of burning left."
        },
        "burning": {
          "type": "boolean",
          "description": "On fire right now."
        },
        "wetness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "How soaked it is (dry … saturated), 0 … 1."
        },
        "frozen": {
          "type": "boolean",
          "description": "Frozen solid."
        },
        "freezePoint": {
          "type": "number",
          "minimum": -273.15,
          "maximum": 10000,
          "description": "Temperature at or below which it freezes, °C."
        },
        "conductive": {
          "type": "boolean",
          "description": "Conducts electric charge."
        },
        "charge": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000,
          "description": "Stored electric charge."
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000,
          "description": "Mass, kg."
        },
        "fragile": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000,
          "description": "Impact energy that breaks it, J."
        },
        "hp": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000,
          "description": "Structural hit points."
        },
        "density": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 100000,
          "description": "Density, kg/m³; below 1000 it floats in water."
        },
        "climbable": {
          "type": "string",
          "enum": [
            "none",
            "ladder",
            "rope",
            "ivy",
            "rough",
            "sheer"
          ],
          "description": "Climbing grade: none, ladder, rope, ivy (easy), rough (needs a climber), sheer (needs a tool)."
        },
        "liftable": {
          "type": "boolean",
          "description": "Can be picked up and carried."
        },
        "pushable": {
          "type": "boolean",
          "description": "Can be pushed or dragged."
        },
        "hideable": {
          "type": "boolean",
          "description": "An actor can hide in or behind it."
        },
        "reflective": {
          "type": "boolean",
          "description": "Reflects light beams and bolts."
        },
        "transparent": {
          "type": "boolean",
          "description": "Light and sight pass through it."
        },
        "opaque": {
          "type": "boolean",
          "description": "Fully blocks light and sight."
        },
        "lightEmitter": {
          "type": "object",
          "properties": {
            "intensity": {
              "type": "number",
              "minimum": 0,
              "maximum": 100000,
              "description": "Light output (a torch is about 100)."
            },
            "radius": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "Reach, m."
            }
          },
          "required": [
            "intensity",
            "radius"
          ],
          "additionalProperties": false,
          "description": "Emits light."
        },
        "soundDamping": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Fraction of sound it absorbs, 0 … 1."
        },
        "friction": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "description": "Surface friction coefficient."
        },
        "impactAbsorb": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Fraction of impact energy it absorbs, 0 … 1."
        },
        "owner": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "Ownership tag (faction or owner id)."
        },
        "liquid": {
          "type": "boolean",
          "description": "A liquid: it pours, puddles and can have a water surface."
        },
        "flammableGas": {
          "type": "boolean",
          "description": "A gas that ignites (flares or explodes) when fire reaches it."
        },
        "extinguishable": {
          "type": "boolean",
          "description": "A fire or light source that water, force or an interaction puts out."
        },
        "waterSurface": {
          "type": "boolean",
          "description": "Top surface of a body of liquid: cold freezes it into walkable ice (needs a liquid material)."
        },
        "unstable": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000,
          "description": "Force of one push, blast or quake that topples it, J."
        },
        "suspended": {
          "type": "boolean",
          "description": "Hangs from its support; falls when the support breaks, burns or is cut."
        },
        "support": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Entity a suspended object hangs from (0 = none); set when the level spawns."
        },
        "breakable": {
          "type": "boolean",
          "description": "A single hit at or above its toughness for that kind of hit breaks it."
        },
        "toughness": {
          "type": "object",
          "properties": {
            "blunt": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000,
              "description": "Blunt hit energy that breaks it, J."
            },
            "slash": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000,
              "description": "Slash hit energy that breaks it, J."
            },
            "pierce": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000,
              "description": "Pierce hit energy that breaks it, J."
            },
            "force": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000,
              "description": "Force (blast, quake, boulder) energy that breaks it, J."
            }
          },
          "additionalProperties": false,
          "description": "Per kind of hit, the single-hit energy that breaks a breakable object; a kind left out never does."
        },
        "bashable": {
          "type": "boolean",
          "description": "A shield bash or kick shoves it (or breaks it when breakable)."
        },
        "cuttable": {
          "type": "boolean",
          "description": "Slash or pierce damage severs it."
        },
        "shootable": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000,
          "description": "Projectile impulse that fires its signal, N·s."
        },
        "softAnchor": {
          "type": "boolean",
          "description": "Rope arrows and hooks embed in it."
        },
        "surfaceHardness": {
          "type": "string",
          "enum": [
            "soft",
            "medium",
            "hard"
          ],
          "description": "Footstep loudness and whether arrows stick (soft, medium) or ricochet (hard)."
        },
        "chargeActivated": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000,
          "description": "Stored charge at which the mechanism fires."
        },
        "lightActivated": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000,
          "description": "Light level on it at which the mechanism fires."
        },
        "hidden": {
          "type": "boolean",
          "description": "Not perceivable or targetable until revealed."
        },
        "trapped": {
          "type": "boolean",
          "description": "Interacting with it triggers its trap unless disarmed first (needs a trap)."
        },
        "trap": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "Trap definition id a trapped object triggers."
        },
        "container": {
          "type": "boolean",
          "description": "Holds items (contents live in the e18 container component)."
        },
        "remains": {
          "type": "boolean",
          "description": "Inert skeletal or corpse remains that summoning can raise."
        },
        "noiseMultiplier": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 3,
          "description": "Multiplier on its wearer's noise; an actor's is the product of its equipment's."
        }
      },
      "additionalProperties": false
    },
    "payload": {
      "description": "Property-based emissions where it lands, in order; empty for a plain arrow.",
      "default": [],
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "const": "applyProperty"
              },
              "property": {
                "type": "string",
                "description": "A canonical world property key (docs/design/world-properties.md)."
              },
              "value": {
                "description": "Value to set, checked against the property’s own range; omit for a flag to set it true.",
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "number"
                    }
                  }
                ]
              },
              "radius": {
                "default": 0,
                "description": "Sphere radius around the impact point, metres; 0 = only the struck entity.",
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "op",
              "property"
            ],
            "additionalProperties": false,
            "description": "Sets a world property on what it reaches; the property’s own rules decide whether it takes (only things flammable right now catch `burning`)."
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "const": "stimulus"
              },
              "element": {
                "type": "string",
                "enum": [
                  "heat",
                  "cold",
                  "water",
                  "charge",
                  "force",
                  "gas",
                  "light",
                  "blunt",
                  "slash",
                  "pierce"
                ],
                "description": "Stimulus element (stimulus API)."
              },
              "intensity": {
                "type": "number",
                "minimum": 0,
                "description": "Total amount at full falloff, in the element’s unit (°C, wetness, N·s, J…)."
              },
              "radius": {
                "default": 0,
                "description": "Sphere radius around the impact point, metres; 0 = only the struck entity.",
                "type": "number",
                "minimum": 0
              },
              "duration": {
                "default": 0,
                "description": "Seconds to spread the intensity over; 0 = at once.",
                "type": "number",
                "minimum": 0
              },
              "falloff": {
                "default": "linear",
                "description": "Intensity falloff inside the sphere (stimulus API): linear to the rim, or none.",
                "type": "string",
                "enum": [
                  "linear",
                  "none"
                ]
              },
              "gas": {
                "description": "Gas type id; required for (and only for) element \"gas\".",
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              }
            },
            "required": [
              "op",
              "element",
              "intensity"
            ],
            "additionalProperties": false,
            "description": "Emits a world stimulus at the impact point (heat, cold, water, charge, gas…)."
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "const": "spawn"
              },
              "entity": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "description": "Id of what it spawns at the impact point, e.g. \"rope\" (defined by the payload’s bead)."
              },
              "length": {
                "description": "Length of a spawned line (rope), metres.",
                "type": "number",
                "exclusiveMinimum": 0
              },
              "anchor": {
                "description": "Flag property the struck surface must have to anchor the spawn (e.g. \"softAnchor\"); without it the arrow bounces and nothing spawns.",
                "type": "string"
              }
            },
            "required": [
              "op",
              "entity"
            ],
            "additionalProperties": false,
            "description": "Spawns a world entity where the arrow lands (a rope to climb)."
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "const": "noise"
              },
              "loudness": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "NoiseEvent loudness at the impact point (mw-e03.25 scale; e05.11 uses 70)."
              },
              "duration": {
                "default": 0,
                "description": "Seconds the sound lasts; 0 = one instant.",
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "op",
              "loudness"
            ],
            "additionalProperties": false,
            "description": "Makes a sound at the impact point that stealth and AI hear (e09)."
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "const": "impactForceMul"
              },
              "factor": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 10,
                "description": "Multiplier on the hit’s impact force and knock impulse (0–10)."
              }
            },
            "required": [
              "op",
              "factor"
            ],
            "additionalProperties": false,
            "description": "Hits harder: knocks objects over and presses switches (blunt heads)."
          }
        ],
        "description": "One payload op; ops apply in list order where the arrow lands."
      }
    },
    "cues": {
      "type": "object",
      "properties": {
        "trailVfx": {
          "type": "string",
          "pattern": "^vfx-[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "Flight trail VFX cue id."
        },
        "impactVfx": {
          "description": "Payload VFX at the impact point; surface puffs come from the surface material.",
          "type": "string",
          "pattern": "^vfx-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "flightSfx": {
          "default": "sfx-arrow-flyby",
          "description": "Audio cue of the arrow passing by (audio bible §6, no round-robin number).",
          "type": "string",
          "pattern": "^sfx-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "impactSfx": {
          "description": "Payload sound layered over the surface impact (the surface material picks wood, stone…).",
          "type": "string",
          "pattern": "^sfx-[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "required": [
        "trailVfx"
      ],
      "additionalProperties": false,
      "description": "Presentation cue ids (style bible §15.1, audio bible §6)."
    },
    "tags": {
      "description": "Free tags for queries and shops, e.g. \"trick\".",
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    }
  },
  "required": [
    "id",
    "name",
    "massGrams",
    "dragK",
    "damage",
    "penetration",
    "onImpact",
    "cues"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Editor hint only; ignored by the loader."
    },
    "id": {
      "type": "string",
      "const": "respawn-rules",
      "description": "Always \"respawn-rules\": there is one rule table."
    },
    "notes": {
      "type": "string",
      "minLength": 1,
      "description": "What the table covers and why."
    },
    "deathBeatSeconds": {
      "type": "number",
      "minimum": 0,
      "maximum": 10,
      "description": "Seconds of sim time from the player’s death to the death screen."
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Unique among the rules; breaks priority ties (lowest id wins)."
          },
          "notes": {
            "description": "Why the rule exists.",
            "type": "string",
            "minLength": 1
          },
          "region": {
            "description": "The scene the player dies in for this rule to apply.",
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "x-contentRef": "scene"
          },
          "priority": {
            "default": 0,
            "description": "Of every matching rule the highest priority wins.",
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "conditions": {
            "description": "A world-fact condition that must hold (docs/design/conditions.md); omit: always.",
            "$ref": "#/$defs/condition"
          },
          "destination": {
            "type": "object",
            "properties": {
              "scene": {
                "description": "The scene of the spawn point.",
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "x-contentRef": "scene"
              },
              "spawn": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "description": "A spawn id that scene places."
              }
            },
            "required": [
              "scene",
              "spawn"
            ],
            "additionalProperties": false,
            "description": "Where the player comes back: the wake-in-place spot, or the start when a reload finds no save."
          },
          "mode": {
            "type": "string",
            "enum": [
              "reload",
              "wake-in-place"
            ],
            "description": "reload: the death screen and Load last save; wake-in-place: wake at the destination."
          },
          "factsToSet": {
            "default": [],
            "description": "Facts written when the rule is chosen.",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "fact": {
                  "type": "string",
                  "pattern": "^(?:entity:[a-z0-9]+(?:-[a-z0-9]+)*\\/[a-z0-9]+(?:-[a-z0-9]+)*\\.)?[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*$",
                  "description": "A declared fact."
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "string",
                      "minLength": 1
                    }
                  ],
                  "description": "A bool, a whole number or a string, fitting the fact type."
                }
              },
              "required": [
                "fact",
                "value"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "region",
          "destination",
          "mode"
        ],
        "additionalProperties": false
      },
      "description": "The rules, in any order."
    }
  },
  "required": [
    "id",
    "notes",
    "deathBeatSeconds",
    "rules"
  ],
  "additionalProperties": false,
  "$defs": {
    "condition": {
      "description": "A condition over world facts: one of fact, count, all, any, not (docs/design/conditions.md).",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "fact": {
              "type": "string",
              "pattern": "^(?:entity:[a-z0-9]+(?:-[a-z0-9]+)*\\/[a-z0-9]+(?:-[a-z0-9]+)*\\.)?[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*$",
              "description": "Fact key to test. Alone: the (bool) fact is true. With one operator: that comparison holds."
            },
            "eq": {
              "description": "The fact equals this value.",
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "string",
                  "minLength": 1
                }
              ]
            },
            "neq": {
              "description": "The fact does not equal this value (unset counts as unequal).",
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "string",
                  "minLength": 1
                }
              ]
            },
            "gt": {
              "description": "The (int or tick) fact is greater than this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "gte": {
              "description": "The (int or tick) fact is at least this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "lt": {
              "description": "The (int or tick) fact is less than this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "lte": {
              "description": "The (int or tick) fact is at most this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "has": {
              "description": "true: the fact holds a value (set, or declared with a non-null default); false: none.",
              "type": "boolean"
            }
          },
          "required": [
            "fact"
          ],
          "additionalProperties": false,
          "description": "Tests one fact, with at most one operator."
        },
        {
          "type": "object",
          "properties": {
            "count": {
              "type": "string",
              "pattern": "^entity:([a-z0-9]+(?:-[a-z0-9]+)*|\\*)\\/\\*\\.([a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*)$",
              "description": "Entity facts to count: `entity:<level>/*.<fact>` (one level) or `entity:*/*.<fact>` (every level). Counts those holding true."
            },
            "eq": {
              "description": "The count equals this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "neq": {
              "description": "The count does not equal this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "gt": {
              "description": "The count is greater than this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "gte": {
              "description": "The count is at least this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "lt": {
              "description": "The count is less than this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "lte": {
              "description": "The count is at most this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "count"
          ],
          "additionalProperties": false,
          "description": "Counts true entity facts matching a pattern, compared with exactly one operator."
        },
        {
          "type": "object",
          "properties": {
            "all": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/condition"
              },
              "description": "Every condition holds."
            }
          },
          "required": [
            "all"
          ],
          "additionalProperties": false,
          "description": "True when every condition in the list holds."
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/condition"
              },
              "description": "At least one holds."
            }
          },
          "required": [
            "any"
          ],
          "additionalProperties": false,
          "description": "True when at least one condition in the list holds."
        },
        {
          "type": "object",
          "properties": {
            "not": {
              "description": "The condition that must not hold.",
              "$ref": "#/$defs/condition"
            }
          },
          "required": [
            "not"
          ],
          "additionalProperties": false,
          "description": "True when the condition does not hold."
        }
      ]
    }
  }
}

      "forearm-r",
      "sword"
    ]
  },
  "layers": [
    {
      "id": "base",
      "initial": "idle",
      "states": [
        {
          "id": "idle",
          "motion": {
            "kind": "clip",
            "clip": "anim-humanoid-idle"
          }
        },
        {
          "id": "move",
          "motion": {
            "kind": "blend1d",
            "param": "speed",
            "points": [
              {
                "at": 0,
                "clip": "anim-humanoid-idle"
              },
              {
                "at": 1.5,
                "clip": "anim-humanoid-walk"
              },
              {
                "at": 4,
                "clip": "anim-humanoid-run"
              }
            ]
          }
        }
      ],
      "transitions": [
        {
          "from": "idle",
          "to": "move",
          "duration": 0.2,
          "when": [
            {
              "param": "speed",
              "op": ">",
              "value": 0.2
            }
          ]
        },
        {
          "from": "move",
          "to": "idle",
          "duration": 0.25,
          "when": [
            {
              "param": "speed",
              "op": "<=",
              "value": 0.2
            }
          ]
        }
      ]
    },
    {
      "id": "action",
      "mask": "upper-body",
      "initial": "none",
      "states": [
        {
          "id": "none",
          "motion": {
            "kind": "none"
          }
        },
        {
          "id": "attack",
          "motion": {
            "kind": "action",
            "fallback": "anim-knight-sword-light-1"
          }
        }
      ],
      "transitions": [
        {
          "from": "none",
          "to": "attack",
          "duration": 0.1,
          "when": [
            {
              "param": "acting",
              "op": "==",
              "value": true
            }
          ]
        },
        {
          "from": "attack",
          "to": "none",
          "duration": 0.2,
          "when": [
            {
              "param": "acting",
              "op": "==",
              "value": false
            }
          ]
        }
      ]
    },
    {
      "id": "hit",
      "mode": "additive",
      "initial": "none",
      "states": [
        {
          "id": "none",
          "motion": {
            "kind": "none"
          }
        },
        {
          "id": "hit-react",
          "motion": {
            "kind": "clip",
            "clip": "anim-humanoid-hit-react"
          }
        }
      ],
      "transitions": [
        {
          "from": "none",
          "to": "hit-react",
          "duration": 0.05,
          "when": [
            {
              "param": "hitReact",
              "op": "==",
              "value": true
            }
          ]
        },
        {
          "from": "hit-react",
          "to": "none",
          "duration": 0.2,
          "when": [
            {
              "param": "hitReact",
              "op": "==",
              "value": false
            }
          ]
        }
      ]
    }
  ]

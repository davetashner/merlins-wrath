{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Editor hint only; ignored by the loader."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Display name for debug overlays."
    },
    "mass": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Mass in kilograms."
    },
    "flammable": {
      "type": "boolean",
      "description": "World property: fire can ignite it."
    },
    "tags": {
      "default": [],
      "description": "Free-form tags for grey-box scenes.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "breaksInto": {
      "description": "Id of the testprop left when this one breaks.",
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "x-contentRef": "testprop"
    },
    "body": {
      "description": "Makes the prop a movable physics object; without one it stays put.",
      "type": "object",
      "properties": {
        "size": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3,
          "description": "Box size along x, y, z in metres; the spawn point is the middle of its base."
        },
        "material": {
          "description": "Material preset (world properties) of the body.",
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "x-contentRef": "material"
        }
      },
      "required": [
        "size",
        "material"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "name",
    "mass",
    "flammable"
  ],
  "additionalProperties": false
}

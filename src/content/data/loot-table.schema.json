{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Editor hint only; ignored by the loader."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Loot table id, e.g. \"testbed-supply-crate\"."
    },
    "notes": {
      "type": "string",
      "minLength": 1,
      "description": "What drops it and why these odds, for owner review."
    },
    "guaranteed": {
      "description": "Items that always drop (unless unique and already obtained).",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "description": "The item.",
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "x-contentRef": "item"
          },
          "count": {
            "default": 1,
            "description": "Units of it.",
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "item"
        ],
        "additionalProperties": false
      }
    },
    "rolls": {
      "description": "How many times `entries` is rolled.",
      "default": {
        "min": 0,
        "max": 0
      },
      "type": "object",
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Fewest rolls on `entries`."
        },
        "max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Most rolls on `entries`."
        }
      },
      "required": [
        "min",
        "max"
      ],
      "additionalProperties": false
    },
    "entries": {
      "description": "Weighted entries each roll picks one of.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "description": "The item this entry yields.",
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "x-contentRef": "item"
          },
          "table": {
            "description": "A loot table this entry rolls instead.",
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "x-contentRef": "loot-table"
          },
          "weight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "description": "Relative chance of this entry per roll."
          },
          "count": {
            "description": "Units of the item, or times the table is rolled, when the entry wins.",
            "default": {
              "min": 1,
              "max": 1
            },
            "type": "object",
            "properties": {
              "min": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "Fewest units (an item) or rolls (a table)."
              },
              "max": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "Most units (an item) or rolls (a table)."
              }
            },
            "required": [
              "min",
              "max"
            ],
            "additionalProperties": false
          },
          "conditions": {
            "type": "object",
            "properties": {
              "class": {
                "description": "The player’s class must be one of these.",
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                  "x-contentRef": "class"
                }
              },
              "when": {
                "description": "A world-fact condition that must hold (mw-e27.5).",
                "$ref": "#/$defs/condition"
              }
            },
            "additionalProperties": false,
            "description": "Simple predicates until the shared condition DSL (mw-e22): every one given must hold."
          }
        },
        "required": [
          "weight"
        ],
        "additionalProperties": false
      }
    },
    "noDuplicates": {
      "default": false,
      "description": "Each entry wins at most once per roll of this table.",
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "notes"
  ],
  "additionalProperties": false,
  "$defs": {
    "condition": {
      "description": "A condition over world facts: one of fact, count, all, any, not (docs/design/conditions.md).",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "fact": {
              "type": "string",
              "pattern": "^(?:entity:[a-z0-9]+(?:-[a-z0-9]+)*\\/[a-z0-9]+(?:-[a-z0-9]+)*\\.)?[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*$",
              "description": "Fact key to test. Alone: the (bool) fact is true. With one operator: that comparison holds."
            },
            "eq": {
              "description": "The fact equals this value.",
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "string",
                  "minLength": 1
                }
              ]
            },
            "neq": {
              "description": "The fact does not equal this value (unset counts as unequal).",
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "string",
                  "minLength": 1
                }
              ]
            },
            "gt": {
              "description": "The (int or tick) fact is greater than this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "gte": {
              "description": "The (int or tick) fact is at least this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "lt": {
              "description": "The (int or tick) fact is less than this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "lte": {
              "description": "The (int or tick) fact is at most this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "has": {
              "description": "true: the fact holds a value (set, or declared with a non-null default); false: none.",
              "type": "boolean"
            }
          },
          "required": [
            "fact"
          ],
          "additionalProperties": false,
          "description": "Tests one fact, with at most one operator."
        },
        {
          "type": "object",
          "properties": {
            "count": {
              "type": "string",
              "pattern": "^entity:([a-z0-9]+(?:-[a-z0-9]+)*|\\*)\\/\\*\\.([a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*)$",
              "description": "Entity facts to count: `entity:<level>/*.<fact>` (one level) or `entity:*/*.<fact>` (every level). Counts those holding true."
            },
            "eq": {
              "description": "The count equals this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "neq": {
              "description": "The count does not equal this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "gt": {
              "description": "The count is greater than this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "gte": {
              "description": "The count is at least this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "lt": {
              "description": "The count is less than this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "lte": {
              "description": "The count is at most this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "count"
          ],
          "additionalProperties": false,
          "description": "Counts true entity facts matching a pattern, compared with exactly one operator."
        },
        {
          "type": "object",
          "properties": {
            "all": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/condition"
              },
              "description": "Every condition holds."
            }
          },
          "required": [
            "all"
          ],
          "additionalProperties": false,
          "description": "True when every condition in the list holds."
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/condition"
              },
              "description": "At least one holds."
            }
          },
          "required": [
            "any"
          ],
          "additionalProperties": false,
          "description": "True when at least one condition in the list holds."
        },
        {
          "type": "object",
          "properties": {
            "not": {
              "description": "The condition that must not hold.",
              "$ref": "#/$defs/condition"
            }
          },
          "required": [
            "not"
          ],
          "additionalProperties": false,
          "description": "True when the condition does not hold."
        }
      ]
    }
  }
}

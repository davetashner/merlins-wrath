{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Editor hint only; ignored by the loader."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Group id, e.g. \"sorcerer-fire\". Unlocks are keyed by capability."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Display name of the group (docs and debug tools)."
    },
    "notes": {
      "type": "string",
      "minLength": 1,
      "description": "What the group covers and where it comes from, for review."
    },
    "unlocks": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "capability": {
            "type": "string",
            "pattern": "^(verb|spell|arrow|tool|trick|technique|sense)\\.[a-z0-9.-]+$",
            "description": "The capability this unlock grants (source `learned`)."
          },
          "prerequisites": {
            "default": [],
            "description": "Capabilities the learner must already know: the previous steps of its chain.",
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(verb|spell|arrow|tool|trick|technique|sense)\\.[a-z0-9.-]+$",
              "description": "Capability id declared in src/content/data/capability/, e.g. \"spell.mage-hand\"."
            }
          },
          "requirements": {
            "description": "World-fact condition that must hold when learning; absent = none.",
            "$ref": "#/$defs/condition"
          },
          "channels": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "book",
                "trainer",
                "schematic",
                "trick",
                "deed"
              ]
            },
            "description": "The in-world channels that may teach it (ADR-0004)."
          },
          "replaces": {
            "description": "A capability this one replaces and subsumes: learning it moves the learned grant over.",
            "type": "string",
            "pattern": "^(verb|spell|arrow|tool|trick|technique|sense)\\.[a-z0-9.-]+$"
          },
          "supporting": {
            "description": "Marks a deliberate numeric (supporting) unlock; required when the capability is supporting.",
            "type": "boolean"
          }
        },
        "required": [
          "capability",
          "channels"
        ],
        "additionalProperties": false
      },
      "description": "The unlocks it defines."
    }
  },
  "required": [
    "id",
    "name",
    "notes",
    "unlocks"
  ],
  "additionalProperties": false,
  "$defs": {
    "condition": {
      "description": "A condition over world facts: one of fact, count, all, any, not (docs/design/conditions.md).",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "fact": {
              "type": "string",
              "pattern": "^(?:entity:[a-z0-9]+(?:-[a-z0-9]+)*\\/[a-z0-9]+(?:-[a-z0-9]+)*\\.)?[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*$",
              "description": "Fact key to test. Alone: the (bool) fact is true. With one operator: that comparison holds."
            },
            "eq": {
              "description": "The fact equals this value.",
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "string",
                  "minLength": 1
                }
              ]
            },
            "neq": {
              "description": "The fact does not equal this value (unset counts as unequal).",
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "string",
                  "minLength": 1
                }
              ]
            },
            "gt": {
              "description": "The (int or tick) fact is greater than this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "gte": {
              "description": "The (int or tick) fact is at least this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "lt": {
              "description": "The (int or tick) fact is less than this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "lte": {
              "description": "The (int or tick) fact is at most this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "has": {
              "description": "true: the fact holds a value (set, or declared with a non-null default); false: none.",
              "type": "boolean"
            }
          },
          "required": [
            "fact"
          ],
          "additionalProperties": false,
          "description": "Tests one fact, with at most one operator."
        },
        {
          "type": "object",
          "properties": {
            "count": {
              "type": "string",
              "pattern": "^entity:([a-z0-9]+(?:-[a-z0-9]+)*|\\*)\\/\\*\\.([a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*)$",
              "description": "Entity facts to count: `entity:<level>/*.<fact>` (one level) or `entity:*/*.<fact>` (every level). Counts those holding true."
            },
            "eq": {
              "description": "The count equals this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "neq": {
              "description": "The count does not equal this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "gt": {
              "description": "The count is greater than this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "gte": {
              "description": "The count is at least this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "lt": {
              "description": "The count is less than this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "lte": {
              "description": "The count is at most this.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "count"
          ],
          "additionalProperties": false,
          "description": "Counts true entity facts matching a pattern, compared with exactly one operator."
        },
        {
          "type": "object",
          "properties": {
            "all": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/condition"
              },
              "description": "Every condition holds."
            }
          },
          "required": [
            "all"
          ],
          "additionalProperties": false,
          "description": "True when every condition in the list holds."
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/condition"
              },
              "description": "At least one holds."
            }
          },
          "required": [
            "any"
          ],
          "additionalProperties": false,
          "description": "True when at least one condition in the list holds."
        },
        {
          "type": "object",
          "properties": {
            "not": {
              "description": "The condition that must not hold.",
              "$ref": "#/$defs/condition"
            }
          },
          "required": [
            "not"
          ],
          "additionalProperties": false,
          "description": "True when the condition does not hold."
        }
      ]
    }
  }
}
